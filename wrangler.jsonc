{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "huntboard",
	"compatibility_date": "2026-10-09",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "huntboard",
			"database_id": "95c667c9-33ff-40f1-a105-25c5b3123727",
			"migrations_dir": "migrations"
		}
	],
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFW7mcwTkgW3s-qb"
	},
	"ratelimits": [
		{
			"name": "CREATE_GAME_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
