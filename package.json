{
	"name": "huntboard",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@12.18.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --local-upstream localhost:4173 --env-file .env.dev",
		"prepare": "svelte-kit sync || echo '' && simple-git-hooks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p loadtest",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types --env-file .env.example --env-file .env.dev --strict-vars false",
		"db:migrate": "wrangler d1 migrations apply huntboard --local",
		"db:migrate:remote": "wrangler d1 migrations apply huntboard --remote",
		"deploy": "vite build && wrangler deploy",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"rehearsal": "playwright test",
		"loadtest": "vite build && node loadtest/run.ts",
		"loadtest:check": "tsc -p loadtest",
		"scan": "sh scripts/require-tools.sh gitleaks trivy && gitleaks git --no-banner --redact --log-opts=HEAD && trivy fs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --include-dev-deps --exit-code 1 --skip-version-check --quiet .",
		"scan:staged": "sh scripts/require-tools.sh gitleaks && gitleaks git --staged --no-banner --redact",
		"knip": "knip"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@playwright/test": "1.65.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"aws4fetch": "^1.0.20",
		"bits-ui": "^2.21.0",
		"client-zip": "^2.5.1",
		"cn": "^0.5.2",
		"devalue": "^6.0.3",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsqr": "^1.4.0",
		"knip": "^6.45.1",
		"lint-staged": "^17.6.0",
		"mediabunny": "^1.66.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"simple-git-hooks": "^2.14.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"uqr": "^0.1.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged && pnpm scan:staged",
		"pre-push": "pnpm check && pnpm test && pnpm scan && pnpm knip"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint"
		],
		"*.{css,html,json,md,yaml,yml}": "prettier --write"
	}
}
